{{> head }}

<body class="container-fluid">
  {{> header }}

  <!-- body  -->
  <div class="row">
    <div class="col-xs-12">

      {{> exchangeRate rate=exchangeRate currencyId=currencyId}}

      <!-- stock entry from purchase -->
      {{#if includePurchaseEntry}}
        <table class="table table-condensed table-report">
          <thead>
            <tr style="background-color: #EFEFEF;">
              <th>{{translate 'STOCK.RECEIPT.ENTRY_PURCHASE'}}</th>
              <th class="text-center">{{translate 'FORM.LABELS.PURCHASE_ORDER' }}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.DATE'}}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.QUANTITY'}}</th>
              <th class="text-center">{{translate 'STOCK.UNIT_COST'}}</th>
              <th class="text-right">{{currency entryFromPurchase.cost currencyId}}</th>
            </tr>
          </thead>
          {{#each entryFromPurchase.data as | data |}}
            <thead>
              <tr>
                <th colspan="3">{{ data.inventory_name }}</th>
                <th colspan="2" class="text-right">{{ data.entry_quantity }}</th>
                <th colspan="1" class="text-right">{{currency data.entry_cost ../currencyId 4}}</th>
              </tr>
            </thead>

            {{#if @root.showDetails}}
              <tbody>
                {{#each data.entry_data as | item |}}
                  <tr>
                    <td style="min-width: 20%; padding-left: 10px;">{{ document_reference }}</td>
                    <td class="text-left" style="min-width: 45%;">({{ purchase_reference }}) {{ supplier_display_name }}</td>
                    <td>{{date date }}</td>
                    <td class="text-right" >{{ quantity }}</td>
                    <td class="text-right" >{{currency unit_cost ../../currencyId 4}}</td>
                    <td class="text-right" >{{currency cost ../../currencyId 4}}</td>
                  </tr>
                {{/each}}
              </tbody>
            {{/if}}
          {{/each}}

          <!-- no data -->
          {{#if entryFromPurchase.isEmpty}}
            <tr><td colspan="6" class="text-center">{{translate 'STOCK.NO_DATA'}}</td></tr>
          {{/if}}
        </table>
        <br/>
      {{/if}}

      <!-- stock entry from integration -->
      {{#if includeIntegrationEntry}}
        <table class="table table-condensed table-report">
          <thead>
            <tr style="background-color: #EFEFEF;">
              <th colspan="2">{{translate 'STOCK.RECEIPT.ENTRY_INTEGRATION'}}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.DATE'}}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.QUANTITY'}}</th>
              <th class="text-center">{{translate 'STOCK.UNIT_COST'}}</th>
              <th class="text-right">{{currency entryFromIntegration.cost currencyId}}</th>
            </tr>
          </thead>
          {{#each entryFromIntegration.data as | data |}}
            <thead>
              <tr>
                <th colspan="3">{{ data.inventory_name }}</th>
                <th colspan="2" class="text-right">{{ data.entry_quantity }}</th>
                <th colspan="1" class="text-right">{{currency data.entry_cost ../currencyId 4}}</th>
              </tr>
            </thead>

            {{#if @root.showDetails}}
              <tbody>
                {{#each data.entry_data as | item |}}
                  <tr>
                    <td style="min-width: 20%; padding-left: 10px;">{{ document_reference }}</td>
                    <td class="text-left" style="min-width: 45%;">{{ description }}</td>
                    <td >{{date date }}</td>
                    <td class="text-right" >{{ quantity }}</td>
                    <td class="text-right" >{{currency unit_cost ../../currencyId 4}}</td>
                    <td class="text-right" >{{currency cost ../../currencyId 4}}</td>
                  </tr>
                {{/each}}
              </tbody>
            {{/if}}
          {{/each}}

          <!-- no data -->
          {{#if entryFromPurchase.isEmpty}}
            <tr><td colspan="6" class="text-center">{{translate 'STOCK.NO_DATA'}}</td></tr>
          {{/if}}
        </table>
        <br/>
      {{/if}}

      <!-- stock entry from donation -->
      {{#if includeDonationEntry}}
        <table class="table table-condensed table-report">
          <thead>
            <tr style="background-color: #EFEFEF;">
              <th colspan="2">{{translate 'STOCK.RECEIPT.ENTRY_DONATION'}}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.DATE'}}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.QUANTITY'}}</th>
              <th class="text-center">{{translate 'STOCK.UNIT_COST'}}</th>
              <th class="text-right">{{currency entryFromDonation.cost currencyId}}</th>
            </tr>
          </thead>
          {{#each entryFromDonation.data as | data |}}
            <thead>
              <tr>
                <th colspan="3">{{ data.inventory_name }}</th>
                <th colspan="2" class="text-right">{{ data.entry_quantity }}</th>
                <th colspan="2" class="text-right">{{currency data.entry_cost ../currencyId 4}}</th>
              </tr>
            </thead>

            {{#if @root.showDetails}}
              <tbody>
                {{#each data.entry_data as | item |}}
                  <tr>
                    <td style="min-width: 20%; padding-left: 10px;">{{ document_reference }}</td>
                    <td class="text-left" style="min-width: 45%;">{{ description }}</td>
                    <td >{{date date }}</td>
                    <td class="text-right" >{{ quantity }}</td>
                    <td class="text-right" >{{currency unit_cost ../../currencyId 4}}</td>
                    <td class="text-right" >{{currency cost ../../currencyId 4}}</td>
                  </tr>
                {{/each}}
              </tbody>
            {{/if}}
          {{/each}}

          <!-- no data -->
          {{#if entryFromDonation.isEmpty}}
            <tr><td colspan="6" class="text-center">{{translate 'STOCK.NO_DATA'}}</td></tr>
          {{/if}}
        </table>
        <br/>
      {{/if}}

      <!-- stock entry to other depot -->
      {{#if includeTransferEntry}}
        <table class="table table-condensed table-report">
          <thead>
            <tr style="background-color: #EFEFEF;">
              <th colspan="2">{{translate 'STOCK.RECEIPT.ENTRY_DEPOT'}}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.DATE'}}</th>
              <th class="text-center">{{translate 'TABLE.COLUMNS.QUANTITY'}}</th>
              <th class="text-center">{{translate 'STOCK.UNIT_COST'}}</th>
              <th class="text-right">{{currency entryFromTransfer.cost currencyId}}</th>
            </tr>
          </thead>
          {{#each entryFromTransfer.data as | data |}}
            <thead>
              <tr>
                <th colspan="3">{{ data.inventory_name }}</th>
                <th colspan="2" class="text-right">{{ data.entry_quantity }}</th>
                <th colspan="2" class="text-right">{{currency data.entry_cost ../currencyId 4}}</th>
              </tr>
            </thead>

            {{#if @root.showDetails}}
              <tbody>
                {{#each data.entry_data as | item |}}
                  <tr>
                    <td style="min-width: 20%; padding-left: 10px;">{{ document_reference }}</td>
                    <td class="text-left" style="min-width: 45%;">{{ depot_name }}</td>
                    <td>{{date date }}</td>
                    <td class="text-right">{{ quantity }}</td>
                    <td class="text-right">{{currency unit_cost ../../currencyId 4}}</td>
                    <td class="text-right">{{currency cost ../../currencyId 4}}</td>
                  </tr>
                {{/each}}
              </tbody>
            {{/if}}
          {{/each}}

          <!-- no data -->
          {{#if entryFromTransfer.isEmpty}}
            <tr><td colspan="6" class="text-center">{{translate 'STOCK.NO_DATA'}}</td></tr>
          {{/if}}
        </table>
        <br/>
      {{/if}}

      <p>
        *<em>{{translate 'STOCK.STOCK_COST_DESCRIPTION'}}</em> <br />
        *<em>{{translate 'STOCK.STOCK_UNIT_COST_ROUNDED'}}</em>
      </p>
    </div>
  </div>
</body>
